{
  "name": "quarto-presentation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quarto presentation viewer: open-stern body shell (BODY-SHELL-03) over the MT1-S5HR3R1 mechanism",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5185",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4185",
    "test": "playwright test tests/body-shell-03.spec.ts tests/body-surface.spec.ts tests/viewer-readability.spec.ts tests/playback-clock.spec.ts tests/playback.spec.ts --workers=1",
    "verify:body-surface": "node tools/verify-body-surface.mjs",
    "capture:body": "playwright test tests/capture-body-shell-03.spec.ts --workers=1",
    "capture:fo1": "playwright test tests/capture-fo1.spec.ts --workers=1",
    "dump:fo1-fit": "playwright test tests/dump-fo1-fit.spec.ts --workers=1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@babylonjs/core": "^8.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
